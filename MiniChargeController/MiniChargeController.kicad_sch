	(text "I_ripple_buck = (V_sys * (V_bus - V_sys)) / (V_bus * F_sw * L)\n= (4.5 * (22 - 4.5)) / (22 * 750e3 * 2.2e-6)  = 2.17\nI_sat = 5 + 2.17/2 = 6A"
		(exclude_from_sim no)
		(at 161.544 18.034 0)
		(effects
			(font
				(size 1.27 1.27)
			)
		)
		(uuid "34c9278f-28f2-4787-9943-799c2f944b01")
	)
	(text "VILIM_HIZ = 1V + 800mΩ × IINDPM\n(assume R2 is low side resistor at 100k, and tied to REGN at 5V)\nVILIM_HIZ = 5V * 100k / (R1 + 100k)\nR1 = (5V * 100k) / (1V + 800mΩ * IINDPM) - 100k\nAO3401A is limiting factor max 0.9W at 70C, 0.085Ω gives:\nIINDPM = sqrt(0.9/0.085) = 3.25A or 3A with margin\nR1 = (5 * 100k) / (1 + 0.8*3) - 100k = 147k"
		(exclude_from_sim no)
		(at 217.678 64.008 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left)
		)
		(uuid "44ebe676-6fb5-4996-b607-770841586a0d")
	)
